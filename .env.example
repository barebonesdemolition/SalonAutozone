DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salon_autozone

# Required on any real database. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Long random value for the admin login page (X-Admin-Key).
ADMIN_SECRET=

# Only needed if a front-end on another domain calls this API (comma-separated).
ALLOWED_ORIGINS=

# Local development / tests only: create tables and insert demo data.
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false

GEMINI_API_KEY=
AI_CHAT_LIMIT_PER_HOUR=30
